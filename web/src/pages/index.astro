---
import Base from "../layouts/Base.astro";
import HeroResult from "../components/HeroResult.astro";
import { loadDomains, loadIndex, loadSearchDocs } from "../lib/catalog";
import { FRAMEWORKS, domainLabel } from "../lib/labels";
import { Catalog, HERO_QUERIES, heroPick } from "../lib/search";
import scoring from "../../../config/scoring.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const index = loadIndex();
const domains = loadDomains();
const order = Object.keys((scoring as { domain_profiles: Record<string, string> }).domain_profiles);
const sorted = [...domains].sort((a, b) => order.indexOf(a.domain) - order.indexOf(b.domain));
const profiles = (scoring as { domain_profiles: Record<string, string> }).domain_profiles;
const frameworks = Object.keys(FRAMEWORKS).length;
const withEvidence = index?.records.filter((r) => r.compliance_summary.some((c) => c.status === "active")).length ?? 0;
const snapshot = index?.snapshot_date ?? "—";
const asOf = index?.built_at ? index.built_at.slice(0, 10) : "—";
// the specimen result: the real #1 for an example query, chosen so it carries evidence when the catalog has any
const pick = index ? heroPick(new Catalog(index.records, loadSearchDocs())) : null;
const tiers = [
  ["T1", "Registry-matched", "found in a named authoritative registry (FedRAMP Marketplace, CSA STAR)"],
  ["T2", "Marketplace-listed", "stated in a cloud marketplace compliance field"],
  ["T3", "Document-evidenced", "certificate or letter reviewed; issuer and dates recorded"],
  ["T4", "Vendor-claimed", "trust-center statement, not yet verified"],
  ["T5", "Unknown", "no evidence found — shown as such, never as non-compliant"],
];
---

<Base title="Discover AI agents. Inspect the evidence." description="AgentDossier — discover AI agents, inspect the evidence behind each one, and decide what fits your risk requirements.">
  <script is:inline define:vars={{ base }}>
    // legacy links: /?q=… → /search/?q=…
    if (location.search.includes("q=") || location.search.includes("domain=")) location.replace(`${base}/search/${location.search}`);
  </script>
  <section class="hero">
    <div>
      <h1>
        <span style="display:block">Discover AI agents.</span>
        <span style="display:block">Inspect the evidence.</span>
        <span style="display:block; color: var(--accent)">Decide what fits your risk requirements.</span>
      </h1>
      <p class="body" style="font-size: 1.1rem; line-height: 1.55; max-width: 56ch; margin-top: 20px">
        Describe what you need. Every result shows what evidence exists, who issued it, what it covers, whether it is
        current — and what is still unknown. Not a certification: a dossier you can check.
      </p>
      <form class="searchbox hero-search" role="search" action={`${base}/search/`} method="get">
        <label class="sr-only" for="hero-q">Describe the agent you need</label>
        <input id="hero-q" name="q" type="search" placeholder="e.g. HIPAA-compliant claims intake agent" autocomplete="off" />
        <button class="btn primary" type="submit">Search</button>
      </form>
      <div class="row examples" aria-label="Example searches">
        <span class="tiny muted">Try:</span>
        {HERO_QUERIES.map((q) => (
          <a class="chip hint" href={`${base}/search/?q=${encodeURIComponent(q)}`}>{q}</a>
        ))}
      </div>
      <p class="small" style="margin-top: 18px">
        <a href={`${base}/domains/`}>Or browse a domain Top 100 →</a>
      </p>
    </div>
    {pick ? <HeroResult pick={pick} /> : <p class="notice warn">No catalog is bundled with this build.</p>}
  </section>

  <div class="stats">
    <div class="stat"><div class="n">{index?.records.length ?? "—"}</div><div class="l">Agents in the catalog</div></div>
    <div class="stat"><div class="n">{withEvidence}</div><div class="l">With evidence on file</div></div>
    <div class="stat"><div class="n">{frameworks}</div><div class="l">Frameworks tracked</div></div>
    <div class="stat"><div class="n">{domains.length || 12}</div><div class="l">Domains, Top 100 each</div></div>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>Pick a domain. Every list is a curated Top 100, scored by a published formula.</h2>
      <span class="small muted">Evidence as of {asOf} · curated list of {snapshot} · score version {index?.score_version ?? "sar-score-2.0"}</span>
    </div>
    {sorted.length === 0 ? (
      <p class="notice warn">No catalog is bundled with this build.</p>
    ) : (
      <div class="domain-grid">
        {sorted.map((d, i) => (
          <a href={`${base}/domains/${d.domain}/`}>
            <span class="eyebrow">{String(i + 1).padStart(2, "0")} · {profiles[d.domain] ?? d.profile} profile</span>
            <span class="name">{d.label ?? domainLabel(d.domain)}</span>
            <span class="top">#1 {d.ranked[0]?.name}</span>
            <span class="cta">Top 100 →</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>One evidence scale, everywhere</h2>
      <a class="small" href={`${base}/methodology/`}>How tiers, freshness and crediting work →</a>
    </div>
    <div class="tier-strip">
      {tiers.map(([t, name, desc]) => (
        <div><b>{t}</b><span><b>{name}</b><span class="muted"> — {desc}</span></span></div>
      ))}
    </div>
    <p class="tiny muted" style="margin-top: 10px">
      The same five tiers apply to identity, compliance, security and protocol support. Tier is always written out; colour is never the only cue.
      Evidence is credited in the score only after the publisher's identity is verified.
    </p>
  </section>

  <div class="band full-bleed">
    <h2><span style="display:block">Built for machines too.</span><span style="display:block">Run your own registry.</span></h2>
    <div>
      <p style="font-size: 1.05rem; line-height: 1.55">
        The registry conforms to Agentic Resource Discovery (ARD) and publishes
        <a href={`${base}/.well-known/ard.json`}>/.well-known/ard.json</a>. The enterprise edition is the same MIT codebase in one
        self-hosted container: discovery of the agents on your own network via ARD, Agent2Agent (A2A) and Model Context
        Protocol (MCP), <code>POST /search</code> and <code>POST /qualify</code> for your agents and pipelines, decision workflow,
        scheduled scans. Nothing leaves your tenant.
      </p>
      <div class="row" style="margin-top: 24px; gap: 12px">
        <a class="btn dark" href={`${base}/enterprise/`}>Enterprise edition →</a>
        <a class="btn" href="https://github.com/Sushegaad/AgentDossier">Code on GitHub · MIT</a>
      </div>
    </div>
  </div>
</Base>
