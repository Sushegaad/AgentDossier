---
import Base from "../../layouts/Base.astro";
import { loadDomains } from "../../lib/catalog";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const domains = loadDomains().sort((a, b) => a.label.localeCompare(b.label));
---

<Base title="Domains">
  <h1>Domains</h1>
  <p class="muted">
    Twelve ranked top-100 lists from the seed workbook (frozen baseline, <code>sar-score-1.0</code>), each with the
    weight profile it was scored under. Discovered resources are listed unranked.
  </p>
  {domains.length === 0 && <p class="notice warn">No catalog in this build.</p>}
  <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))">
    {domains.map((d) => (
      <a class="card" href={`${base}/domains/${d.domain}/`} style="color: inherit">
        <h3>{d.label}</h3>
        <p class="muted small" style="margin: 0">
          {d.ranked.length} ranked · {d.discovered.length} discovered · profile {d.profile}
        </p>
        <p class="small" style="margin: 0.5rem 0 0">
          {d.ranked.slice(0, 3).map((r) => r.name).join(" · ")}
        </p>
      </a>
    ))}
  </div>
</Base>
