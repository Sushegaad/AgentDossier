---
import Base from "../../layouts/Base.astro";
import { loadDomains } from "../../lib/catalog";
import { DOMAIN_PROFILES } from "../../lib/dossier";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const order = Object.keys(DOMAIN_PROFILES);
const domains = loadDomains().sort((a, b) => order.indexOf(a.domain) - order.indexOf(b.domain));
---

<Base title="Domains">
  <h1 style="font-size: clamp(2rem, 4.5vw, 3rem)">Twelve domains. Every list is Top 100.</h1>
  <p class="body" style="margin-top: 14px; max-width: 72ch">
    Each Top 100 is the curated workbook's list for that domain, in the curator's order. Beside every row, a published
    formula (<code>sar-score-2.0</code>) scores it with trust and governance taken from the evidence ledger on every build.
    Discovered resources are listed unranked beneath each table.
  </p>
  {domains.length === 0 && <p class="notice warn" style="margin-top: 1rem">No catalog in this build.</p>}
  <div class="domain-grid" style="margin-top: 24px">
    {domains.map((d, i) => (
      <a href={`${base}/domains/${d.domain}/`}>
        <span class="eyebrow">{String(i + 1).padStart(2, "0")} · {DOMAIN_PROFILES[d.domain] ?? d.profile} profile</span>
        <span class="name">{d.label}</span>
        <span class="top">#1 {d.ranked[0]?.name} · {d.ranked.length} ranked · {d.discovered.length} discovered</span>
        <span class="cta">Top 100 →</span>
      </a>
    ))}
  </div>
</Base>
