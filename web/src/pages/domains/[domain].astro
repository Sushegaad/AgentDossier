---
import Base from "../../layouts/Base.astro";
import { loadDomains } from "../../lib/catalog";
import { COMPONENT_MAX, DOMAIN_PROFILES, PROFILES } from "../../lib/dossier";
import { IDENTITY_WORD, badgeLabel, securityWord } from "../../lib/labels";

export function getStaticPaths() {
  const all = loadDomains();
  return all.map((d) => ({ params: { domain: d.domain }, props: { d, all } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { d, all } = Astro.props;
const order = Object.keys(DOMAIN_PROFILES);
const sorted = [...all].sort((a, b) => order.indexOf(a.domain) - order.indexOf(b.domain));
const num = order.indexOf(d.domain) + 1;
const profile = DOMAIN_PROFILES[d.domain] ?? d.profile;
const w = PROFILES[profile] ?? PROFILES.general;
const wtext = Object.entries(w).map(([k, v]) => `${k.replace("_", " ")} ${v}`).join(", ");
const comps = Object.keys(COMPONENT_MAX);
const short: Record<string, string> = { adoption: "Adopt", trust: "Trust", health: "Health", ecosystem: "Eco", domain_fit: "Fit", governance: "Gov", docs: "Docs" };
// ✔ observed at the publisher's well-known endpoint · ○ documented by the vendor or named by the resource itself
// · – probed, nothing there · ? never probed (code-host URL or no publisher domain)
const g = (s: string | undefined) => (s === "verified" ? "✔" : s === "claimed" ? "○" : s === "unknown" || !s ? "?" : "–");
const asOf = d.built_at ? d.built_at.slice(0, 10) : d.snapshot_date;
// evidence about the agent itself, then what the vendor holds at organisation level
const evidenceCell = (t: { compliance: number; vendor_compliance?: number | null }) => `${t.compliance === 5 ? "agent –" : `agent T${t.compliance}`}${t.vendor_compliance ? ` · vendor T${t.vendor_compliance}` : ""}`;
// the protocols column only earns its place when enough rows have something in it; otherwise one
// honest line above the table says how many publish metadata, and the dossiers carry the detail
const withProtocol = d.ranked.filter((r) => ["verified", "claimed"].includes(r.protocols.mcp) || ["verified", "claimed"].includes(r.protocols.a2a) || ["verified", "claimed"].includes(r.protocols.ard)).length;
const showProtocols = d.ranked.length > 0 && withProtocol / d.ranked.length >= 0.1;
---

<Base title={`${d.label} · Top 100`}>
  <nav class="row small" style="border-bottom: 1px solid var(--rule); padding-bottom: 8px; margin-bottom: 20px; gap: 1.25rem" aria-label="Domains">
    {sorted.map((x) => (
      <a href={`${base}/domains/${x.domain}/`} style={x.domain === d.domain ? "color: var(--accent-ink); font-weight: 800; text-decoration: none; border-bottom: 2px solid var(--accent-ink)" : "color: var(--ink); text-decoration: none"}>
        {x.label.split(/[,&]/)[0].trim()}
      </a>
    ))}
  </nav>
  <div class="eyebrow muted">Domain {num} of {sorted.length} · {profile} profile</div>
  <h1 style="margin-top: 6px; font-size: clamp(2rem, 4.5vw, 3rem)">{d.label} · Top 100</h1>
  <p class="body" style="margin-top: 14px; max-width: 72ch">
    The Top 100 and its order are the curated {d.snapshot_date} workbook: the curator's judgment of which agents belong here and how well they fit.
    The evidence columns are recomputed on every build — <strong>Trust</strong> from the publisher check and protocol probes, <strong>Gov</strong> from credited compliance evidence (vendor-level rows at half credit) — and the
    <strong>Score</strong> weights all components under the <strong>{profile}</strong> profile ({wtext}). The score is shown beside the rank, not used to sort it.
    Scores are comparative discovery signals, not certification. Evidence as of {asOf} · {d.score_version}.
  </p>
  <div class="row" style="margin: 20px 0 12px; gap: 12px">
    <a class="btn" href={`${base}/search/?domain=${d.domain}`}>Search within {d.label.split(/[,&]/)[0].trim()}</a>
    <a class="btn" href={`${base}/catalog/domains/${d.domain}.json`}>Export JSON</a>
  </div>
  {!showProtocols && d.ranked.length > 0 && (
    <p class="small muted" style="margin: 0 0 10px">
      Protocols: {withProtocol} of {d.ranked.length} ranked agents publish MCP, A2A or ARD metadata that the build could observe or the vendor documents; each dossier shows what was checked.
    </p>
  )}
  <div class="scroll-x" tabindex="0">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Agent / product</th>
          <th>Trust profile</th>
          {showProtocols && <th>Protocols (MCP · A2A · ARD)</th>}
          <th>License</th>
          {comps.map((c) => <th title={c}>{short[c]}</th>)}
          <th title="evidence-weighted score; the list is in curated order">Score</th>
        </tr>
      </thead>
      <tbody>
        {d.ranked.map((r) => (
          <tr>
            <td style="font-weight: 800">{r.rank}</td>
            <td>
              <a href={`${base}/agents/${r.slug}/`} style="font-weight: 800; color: var(--ink); text-decoration: none">{r.name}</a>
              <div class="tiny muted">{r.vendor} · {r.category}</div>
            </td>
            <td>
              <div style="font-weight: 800">Publisher {IDENTITY_WORD[r.trust.identity as 1 | 2 | 3 | 4 | 5]} · evidence {evidenceCell(r.trust)}</div>
              <div class="tiny muted">{securityWord(null, r.trust.security)} · {r.trust.issues == null ? "issues –" : r.trust.issues === 1 ? "no issues" : "issues linked"}</div>
            </td>
            {showProtocols && <td style="white-space: nowrap">{g(r.protocols.mcp)} · {g(r.protocols.a2a)} · {g(r.protocols.ard)}</td>}
            <td class="small">{r.license ?? "—"}</td>
            {comps.map((c) => <td class="small muted">{r.components?.[c] == null ? "?" : Math.round(r.components[c] as number)}</td>)}
            <td style="font-weight: 800">{Math.round(r.score)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tiny muted" style="margin-top: 10px">
    MCP = Model Context Protocol, A2A = Agent2Agent, ARD = Agentic Resource Discovery · ✔ verified at the publisher's endpoint · ○ claimed (vendor documentation or the resource's own description) · – probed, not found · ? not probed (code-host URL or no publisher domain) · components: adoption /30, trust /25, health /20, ecosystem /15, fit /100, governance /100, docs /10 · "?" = unknown, counted as 0.
  </p>
  {d.discovered.length > 0 && (
    <section class="section" style="margin-top: 48px">
      <div class="section-head"><h2>Discovered, unranked</h2><span class="small muted">found by the connectors; classified into this domain but not scored against the seed baseline</span></div>
      <div class="ledger">
        {d.discovered.map((r) => (
          <div class="ledger-row" style="grid-template-columns: 1fr auto">
            <span><a href={`${base}/agents/${r.slug}/`}>{r.name}</a> <span class="muted small">{r.vendor}</span></span>
            <span class="tierbox">Publisher {IDENTITY_WORD[r.trust.identity as 1 | 2 | 3 | 4 | 5]}</span>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
