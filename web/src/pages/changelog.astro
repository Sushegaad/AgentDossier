---
import Base from "../layouts/Base.astro";
import { loadChangelog, loadIndex } from "../lib/catalog";
import { frameworkName, variantLabel } from "../lib/labels";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const events = loadChangelog(300);
const index = loadIndex();
const slugOf = (id: string) => index?.records.find((r) => r.id === id)?.slug;
---

<Base title="Trust changelog">
  <h1>Trust changelog</h1>
  <p class="muted" style="max-width: 70ch">
    Every weekly build diffs each agent's compliance evidence against the last published catalog and records badges
    that were added, changed tier or status, or disappeared. This is the registry's own accountability trail.
  </p>
  {events.length === 0 ? (
    <p class="notice">No events yet. The first entries appear after the second weekly refresh.</p>
  ) : (
    <div class="scroll-x">
      <table>
        <thead><tr><th>When</th><th>Agent</th><th>Event</th><th>Framework</th><th>Change</th></tr></thead>
        <tbody>
          {events.map((e) => (
            <tr>
              <td class="muted small">{e.at.slice(0, 10)}</td>
              <td>{slugOf(e.resource_id) ? <a href={`${base}/agents/${slugOf(e.resource_id)}/`}>{e.resource}</a> : e.resource}</td>
              <td><span class={`badge${e.event === "badge_removed" ? " warn" : e.event === "badge_added" ? " ok" : ""}`}>{e.event.replace("badge_", "")}</span></td>
              <td>{frameworkName(e.framework)}{e.variant ? ` · ${variantLabel(e.variant)}` : ""}</td>
              <td class="small">
                {e.event === "badge_added" && `T${e.tier} ${e.status}${e.source ? ` (${e.source})` : ""}`}
                {e.event === "badge_changed" && `T${e.from?.tier} ${e.from?.status} → T${e.to?.tier} ${e.to?.status}`}
                {e.event === "badge_removed" && `was T${e.from?.tier} ${e.from?.status}`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
