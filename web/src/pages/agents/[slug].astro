---
import Base from "../../layouts/Base.astro";
import TrustStrip from "../../components/TrustStrip";
import ShortlistButton from "../../components/ShortlistButton";
import { loadResources } from "../../lib/catalog";
import {
  IDENTITY_EVIDENCE,
  IDENTITY_LABEL,
  NEWS_TAG_LABEL,
  RISK_TAGS,
  TIER_LABEL,
  domainLabel,
  fmtDate,
  frameworkName,
  protocolLabel,
  sourceLabel,
  variantLabel,
} from "../../lib/labels";

export function getStaticPaths() {
  return loadResources().map((res) => ({ params: { slug: res.slug }, props: { res } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { res } = Astro.props;
const domains = Object.entries(res.domains).sort((a, b) => (a[1].rank ?? 999) - (b[1].rank ?? 999));
const compliance = [...(res.compliance ?? [])].sort((a, b) => a.tier - b.tier || a.framework.localeCompare(b.framework));
const active = compliance.filter((c) => c.status === "active");
const issues = res.issues;
const news = res.news ?? [];
const protocols = Object.entries(res.protocols ?? {});
const cves = issues?.links.filter((l) => l.kind === "cve") ?? [];
const riskLinks = issues?.links.filter((l) => l.kind !== "cve") ?? [];
const compsOrder = ["adoption", "trust", "health", "ecosystem", "domain_fit", "governance", "docs"];
const compMax: Record<string, number> = { adoption: 30, trust: 25, health: 20, ecosystem: 15, domain_fit: 100, governance: 100, docs: 10 };
---

<Base title={res.name} description={res.description ?? undefined}>
  <article>
    <header class="row" style="justify-content: space-between; align-items: flex-start; margin-bottom: 1rem">
      <div>
        <h1>{res.name}</h1>
        <p class="muted" style="margin: 0">
          {res.vendor}
          {res.category && <> · {res.category}</>} · {res.resource_type.replace(/_/g, " ")}
          {res.license && <> · {res.license}</>}
          {res.url && (
            <>
              {" · "}
              <a href={/^https?:/.test(res.url) ? res.url : `https://${res.url}`} rel="noopener">{res.publisher_domain ?? res.url}</a>
            </>
          )}
        </p>
        {res.description && <p style="margin: 0.5rem 0 0; max-width: 70ch">{res.description}</p>}
      </div>
      <div class="row">
        <ShortlistButton client:load id={res.id} slug={res.slug} name={res.name} vendor={res.vendor} />
        <a class="btn" href={`${base}/compare/?ids=${res.slug}`}>Compare</a>
      </div>
    </header>

    <section class="card">
      <h2 style="margin-top: 0">Trust profile</h2>
      <TrustStrip trust={res.trust} />
      <dl class="facts" style="margin-top: 0.75rem">
        <dt>Identity</dt>
        <dd>
          T{res.identity.tier} · {IDENTITY_LABEL[res.identity.tier]}
          {res.identity.evidence.length > 0 && (
            <span class="muted"> — {res.identity.evidence.map((e) => IDENTITY_EVIDENCE[e] ?? e).join("; ")}</span>
          )}
          {res.identity.verified_by && <span class="muted"> (checked by {res.identity.verified_by} on {res.identity.verified_on})</span>}
        </dd>
        <dt>Evidence</dt>
        <dd>
          {active.length
            ? `${active.length} active record${active.length === 1 ? "" : "s"}; best tier T${Math.min(...active.map((c) => c.tier))} (${TIER_LABEL[Math.min(...active.map((c) => c.tier)) as 1]})`
            : "no compliance evidence found in the sources checked"}
        </dd>
        <dt>Security</dt>
        <dd>
          {res.security
            ? `${res.security.cves} CVE${res.security.cves === 1 ? "" : "s"} matching the product name in NVD (checked ${fmtDate(res.security.checked_at)})`
            : "not checked in this build"}
        </dd>
        <dt>Protocols</dt>
        <dd>{protocols.map(([p, b]) => `${p.toUpperCase()}: ${protocolLabel(b.status)}`).join(" · ") || "not checked"}</dd>
        <dt>Issues</dt>
        <dd>
          {issues && (res.news_checked || res.security)
            ? issues.links.length
              ? `${issues.incidents} incident${issues.incidents === 1 ? "" : "s"}, ${issues.cves} CVE${issues.cves === 1 ? "" : "s"}, ${issues.regulator_actions} regulator action${issues.regulator_actions === 1 ? "" : "s"} — see below`
              : "none found in news or NVD"
            : "not checked in this build"}
        </dd>
      </dl>
      {res.identity.tier > 2 && active.length > 0 && (
        <p class="notice warn small" style="margin: 0.75rem 0 0">
          Evidence is shown but <strong>not credited</strong> in the evidence-based governance score until the publisher's
          identity reaches tier 2 (an ARD manifest or A2A card on the vendor's domain, a marketplace listing, or a
          maintainer-verified publisher domain). This is deliberate: a certificate that belongs to a company is only
          credited to an agent once we know the agent is that company's.
        </p>
      )}
    </section>

    <div class="grid two" style="margin-top: 1rem">
      <div>
        <section class="card">
          <h2 style="margin-top: 0">Compliance evidence</h2>
          {compliance.length === 0 ? (
            <p class="muted">
              No evidence found in the FedRAMP Marketplace, the CSA STAR Registry, curated records or the vendor's own
              trust pages as of this build. Absence of evidence is not evidence of absence; ask the vendor.
            </p>
          ) : (
            <ul class="evidence" style="padding-left: 0; list-style: none; margin: 0">
              {compliance.map((c) => (
                <li class="row" style="align-items: flex-start; padding: 0.5rem 0; border-bottom: 1px solid var(--border)">
                  <span class={`tier${c.credited === false && c.status === "active" ? " pending" : ""}`} data-tier={c.tier} title={TIER_LABEL[c.tier]}>
                    T{c.tier}
                  </span>
                  <div style="flex: 1 1 260px">
                    <div>
                      <strong>{frameworkName(c.framework)}</strong>
                      {c.variant && <> · {variantLabel(c.variant)}</>}
                      {c.status !== "active" && <span class="badge warn" style="margin-left: 0.4rem">{c.status.replace(/_/g, " ")}</span>}
                    </div>
                    <div class="small">{c.display}</div>
                    <div class="muted small">
                      <a href={c.evidence_url} rel="noopener">evidence</a> · {sourceLabel(c.source)} · scope {c.scope}
                      {c.issuer && <> · issuer {c.issuer}</>}
                      {c.valid_until && <> · valid to {c.valid_until}</>}
                      {c.period_end && <> · period end {c.period_end}</>}
                      {c.match_confidence != null && c.match_confidence < 1 && <> · match {Math.round(c.match_confidence * 100)}%</>}
                      {c.next_check && <> · next check {c.next_check}</>}
                      {c.reviewer && <> · reviewed by {c.reviewer}</>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
          <p class="muted small" style="margin: 0.75rem 0 0">
            T1 registry-matched · T2 marketplace-listed · T3 document-evidenced · T4 vendor-claimed. Dashed badges are
            pending publisher verification. <a href={`${base}/methodology/#evidence-tiers`}>How tiers work</a>.
          </p>
        </section>

        <section class="card" style="margin-top: 1rem">
          <h2 style="margin-top: 0">News and chatter</h2>
          {!res.news_checked ? (
            <p class="muted">Not checked in this build.</p>
          ) : news.length === 0 ? (
            <p class="muted">Nothing linked with confidence ≥ 0.85 in the last 90 days from Hacker News, GDELT, GitHub releases or the vendor's feed.</p>
          ) : (
            <ul style="padding-left: 0; list-style: none; margin: 0">
              {news.map((n) => (
                <li style="padding: 0.45rem 0; border-bottom: 1px solid var(--border)">
                  <span class={`badge${RISK_TAGS.has(n.tag) ? " danger" : ""}`}>{NEWS_TAG_LABEL[n.tag] ?? n.tag}</span>{" "}
                  <a href={n.url} rel="noopener">{n.headline}</a>
                  <div class="muted small">
                    {n.outlet} · {fmtDate(n.date)} · {n.kind}
                    {n.cluster_size && n.cluster_size > 1 && <> · also in {n.cluster_size - 1} other outlet{n.cluster_size > 2 ? "s" : ""}</>}
                    {n.engagement != null && <> · {n.engagement} points+comments</>}
                    {n.discussion_url && <> · <a href={n.discussion_url} rel="noopener">discussion</a></>}
                    {" · link confidence "}{n.link_confidence}
                  </div>
                  {n.summary && <div class="small">{n.summary}</div>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>

      <div>
        <section class="card">
          <h2 style="margin-top: 0">Rankings</h2>
          {domains.length === 0 ? (
            <p class="muted">Not ranked; discovered by a connector.</p>
          ) : (
            <table>
              <thead><tr><th>Domain</th><th>#</th><th>Score</th><th title="evidence-based governance, sar-score-1.1">Gov. evidence</th></tr></thead>
              <tbody>
                {domains.map(([d, e]) => (
                  <tr>
                    <td><a href={`${base}/domains/${d}/`}>{domainLabel(d)}</a></td>
                    <td>{e.rank ?? "–"}</td>
                    <td>{e.score?.toFixed(1) ?? "–"}</td>
                    <td>{e.governance_evidence?.value != null ? e.governance_evidence.value.toFixed(0) : "–"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {res.components && (
            <>
              <h3 style="margin-top: 1rem">Score components</h3>
              <dl class="facts">
                {compsOrder.filter((k) => res.components && k in res.components).map((k) => {
                  const v = res.components?.[k];
                  return (
                    <>
                      <dt>{k.replace(/_/g, " ")}</dt>
                      <dd>
                        {v == null ? (
                          <span class="muted">unknown (counts as 0)</span>
                        ) : (
                          <>
                            {v} / {compMax[k]}
                            <div class="meter" aria-hidden="true"><span style={`width: ${Math.min(100, (100 * v) / compMax[k])}%`}></span></div>
                          </>
                        )}
                      </dd>
                    </>
                  );
                })}
              </dl>
              <p class="muted small" style="margin: 0.5rem 0 0">
                Workbook components (<code>sar-score-1.0</code>). Governance evidence is computed separately from credited
                records and shown per domain above.
              </p>
            </>
          )}
        </section>

        <section class="card" style="margin-top: 1rem">
          <h2 style="margin-top: 0">Protocols</h2>
          <dl class="facts">
            {protocols.map(([p, b]) => (
              <>
                <dt>{p.toUpperCase()}</dt>
                <dd>
                  {protocolLabel(b.status)}
                  {b.card_url && <> · <a href={String(b.card_url)} rel="noopener">agent card</a></>}
                  {b.manifest_url && <> · <a href={String(b.manifest_url)} rel="noopener">manifest</a></>}
                  {b.endpoint && <> · <code>{String(b.endpoint)}</code></>}
                  {b.version && <> · v{String(b.version)}</>}
                  {b.tools != null && <> · {String(b.tools)} tools</>}
                  {b.checked_at && <span class="muted"> · checked {fmtDate(String(b.checked_at))}</span>}
                  {b.error && <span class="muted"> · {String(b.error)}</span>}
                </dd>
              </>
            ))}
          </dl>
          <p class="muted small" style="margin: 0.5rem 0 0">
            Verified = fetched and parsed from the publisher's domain; claimed = declared by a source but not fetched.
          </p>
        </section>

        <section class="card" style="margin-top: 1rem">
          <h2 style="margin-top: 0">Security and issues</h2>
          {!issues || (!res.news_checked && !res.security) ? (
            <p class="muted">Not checked in this build.</p>
          ) : (
            <>
              <dl class="facts">
                <dt>CVEs (NVD)</dt>
                <dd>{res.security ? res.security.cves : "not checked"}</dd>
                <dt>Incidents</dt>
                <dd>{issues.incidents}</dd>
                <dt>Regulator actions</dt>
                <dd>{issues.regulator_actions}</dd>
              </dl>
              {cves.length > 0 && (
                <ul class="small">
                  {cves.slice(0, 10).map((l) => (
                    <li><a href={l.url} rel="noopener">{l.title}</a> <span class="muted">{l.date}</span></li>
                  ))}
                </ul>
              )}
              {riskLinks.length > 0 && (
                <ul class="small">
                  {riskLinks.map((l) => (
                    <li><span class="badge danger">{NEWS_TAG_LABEL[l.kind] ?? l.kind}</span> <a href={l.url} rel="noopener">{l.title}</a> <span class="muted">{l.date}</span></li>
                  ))}
                </ul>
              )}
              <p class="muted small" style="margin: 0.5rem 0 0">
                CVE counts come from a keyword search on the product name and can include unrelated products with similar names.
              </p>
            </>
          )}
        </section>

        <section class="card" style="margin-top: 1rem">
          <h2 style="margin-top: 0">Provenance</h2>
          <dl class="facts">
            <dt>Sources</dt>
            <dd>
              {res.sources.map((s) => (
                <div>
                  {sourceLabel(s.system)}
                  {s.url && <> · <a href={s.url} rel="noopener">link</a></>}
                  {s.payload_hash && <span class="muted"> · <code title={s.payload_hash}>{s.payload_hash.slice(0, 12)}…</code></span>}
                </div>
              ))}
            </dd>
            {res.first_seen && <><dt>First seen</dt><dd>{fmtDate(res.first_seen)}</dd></>}
            {res.merged_ids && res.merged_ids.length > 0 && <><dt>Merged</dt><dd>{res.merged_ids.length} duplicate record{res.merged_ids.length === 1 ? "" : "s"}</dd></>}
            <dt>ID</dt>
            <dd><code>{res.id}</code></dd>
            <dt>Data</dt>
            <dd><a href={`${base}/catalog/agents/${res.id}.json`}>JSON</a></dd>
          </dl>
        </section>
      </div>
    </div>
    <p class="notice small" style="margin-top: 1.5rem">
      {res.disclaimer ?? "Compliance information is compiled from the sources shown as of the date shown. It is not an assessment, certification, legal opinion or recommendation."}
      {" "}Something wrong? <a href="https://github.com/Sushegaad/AgentDossier/issues/new">Open a correction</a>.
    </p>
  </article>
</Base>
