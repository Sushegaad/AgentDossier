---
import Base from "../../layouts/Base.astro";
import AgentProfile from "../../components/AgentProfile";
import { loadResources } from "../../lib/catalog";
import { beforeYouDeploy } from "../../lib/deploy";
import { referenceFor } from "../../lib/reference";
import { incidentSlug, incidentsForAgent } from "../../lib/incidents";

export function getStaticPaths() {
  return loadResources().map((res) => ({ params: { slug: res.slug }, props: { res } }));
}
const { res } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// the reference set (data/curated/reference_set.yaml) is read at build time only
const ref = referenceFor(res.slug);
const deploy = beforeYouDeploy(res, ref);
const comparison = ref ? { href: `${base}/compare/${ref.useCase.id}/`, title: ref.useCase.title } : null;
const incidents = incidentsForAgent(res.slug);
---

<Base title={res.name} description={res.description ?? undefined}>
  {/* rendered at build time with no client-side React: the dossier is static HTML */}
  <AgentProfile resource={res} shortlist="static" deploy={deploy} comparison={comparison} />
  {incidents.length > 0 && (
    <section class="container" style="max-width: 82ch; margin: 0 auto 40px; border-top: 2px solid var(--accent); padding-top: 12px">
      <h2 style="font-size: 1.25rem">Appears in the incident registry</h2>
      <p class="tiny muted">Public traces of this agent (or its platform) attacking or defending a system.</p>
      <div class="ledger" style="margin-top: 8px">
        {incidents.map((inc) => (
          <div class="ledger-row" style="grid-template-columns: 110px 1fr auto">
            <span style="font-weight: 800"><a href={`${base}/traces/${incidentSlug(inc.id)}/`}>{inc.id}</a></span>
            <span>{inc.title}</span>
            <span class="tiny muted" style="text-align: right">{(inc.tactics ?? []).join(" · ")}</span>
          </div>
        ))}
      </div>
    </section>
  )}
  <script>
    import { inShortlist, onShortlistChange, toggleShortlist } from "../../lib/shortlist";
    const btn = document.querySelector<HTMLButtonElement>("button[data-shortlist-id]");
    if (btn) {
      const item = { id: btn.dataset.shortlistId!, slug: btn.dataset.slug!, name: btn.dataset.name!, vendor: btn.dataset.vendor || null };
      const paint = () => {
        const on = inShortlist(item.id);
        btn.setAttribute("aria-pressed", String(on));
        btn.textContent = on ? "★ Shortlisted" : "☆ Shortlist";
      };
      btn.addEventListener("click", () => {
        toggleShortlist(item);
        paint();
      });
      onShortlistChange(paint);
      paint();
    }
  </script>
</Base>
