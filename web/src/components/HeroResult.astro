---
/**
 * The homepage specimen: the real #1 result for an example query, rendered at build time from the
 * catalog so the first thing a visitor sees is what a result looks like — score, evidence with
 * issuer and date, the gaps, and why it ranked first. Never hand-written; see lib/search.ts heroPick.
 */
import { loadResource } from "../lib/catalog";
import { evidenceGroups, evidenceRows, protocolLines, tierRange } from "../lib/dossier";
import { loadReferenceSet, referenceFor } from "../lib/reference";
import { IDENTITY_LABEL, IDENTITY_WORD, TRACE_KIND_WORD, TRACE_TIER_WORD, badgeLabel, domainLabel } from "../lib/labels";
import type { HeroPick } from "../lib/search";

interface Props {
  pick: HeroPick;
}
const { pick } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const r = pick.hit.record;
const res = loadResource(r.id);
const groups = res ? evidenceGroups(res) : { agent: [], vendor: [] };
// evidence about the agent first; vendor-inherited rows only fill remaining slots, labelled as such
const rows = [...groups.agent.filter((x) => x.mark !== "missing"), ...groups.vendor.filter((x) => x.mark !== "missing")].slice(0, 3);
const gaps = res ? evidenceRows(res).filter((x) => x.mark === "missing").map((x) => badgeLabel(x.framework, null)).slice(0, 3) : [];
const protos = res ? protocolLines(res).filter((l) => ["verified", "claimed"].includes(l.status)) : [];
const domainEntry = Object.entries(r.domains).sort((a, b) => (a[1].rank ?? 999) - (b[1].rank ?? 999))[0];
const evidenceTier = res ? tierRange(res) : "T5";
const ref = referenceFor(r.slug, loadReferenceSet());
// the traces: what this agent did under attack. Best (lowest) tier first, then newest; the home
// specimen shows the attack/defence traces, not the registry's own endpoint probes.
const traces = [...(res?.traces ?? [])].sort((a, b) => a.tier - b.tier || b.date.localeCompare(a.date));
const shown = traces.filter((t) => t.kind !== "self_test").slice(0, 2);
const inDefence = traces.filter((t) => t.observed?.refused).length;
const bundleKinds = ["self_test", "injection_eval", "vendor_published"];
const traceHref = (t: (typeof traces)[number]) => (bundleKinds.includes(t.kind) ? `${base}/traces/bundle/${t.id}/` : t.url);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const why = [...pick.hit.explanation.slice(0, 3), ...(traces.length ? [`${traces.length === 1 ? "one" : traces.length} public trace${traces.length === 1 ? "" : "s"} on record`] : [])].join(" · ");
---

<aside class="hero-result" aria-label="Example result">
  <div class="eyebrow">
    #1 for “{pick.query}”{domainEntry?.[1].rank ? ` · ${domainLabel(domainEntry[0])} #${domainEntry[1].rank} of 100` : ""}
  </div>
  <div class="row" style="justify-content: space-between; align-items: baseline; gap: 12px">
    <h3><a href={`${base}/agents/${r.slug}/`}>{r.name}</a></h3>
    <div class="score"><span class="n">{Math.round(pick.hit.score)}</span><span class="tiny muted"> fit</span></div>
  </div>
  <div class="small muted">{r.vendor}{r.category ? ` · ${r.category}` : ""}</div>
  <div class="strip">
    <span class="tierbox">Publisher {IDENTITY_WORD[r.trust.identity as 1 | 2 | 3 | 4 | 5]}</span>
    <span class="tierbox">Evidence {evidenceTier}</span>
    {protos.map((l) => <span class="tierbox">{l.key.toUpperCase()} {l.status === "verified" ? "✔" : "○"}</span>)}
    {traces.length > 0 && <span class="tierbox trace-chip">⚠ {traces.length} trace{traces.length === 1 ? "" : "s"}</span>}
  </div>
  {rows.length > 0 ? (
    <ul class="evidence">
      {rows.map((x) => (
        <li>
          <span class={`mark ${x.mark}`} aria-hidden="true">{x.mark === "found" ? "✔" : x.mark === "claimed" ? "○" : "⚠"}</span>
          <span><b>{badgeLabel(x.framework, x.variant)}</b> <span class="muted">— {x.tierLabel}{x.aboutAgent ? "" : " · vendor-level"}{x.asOf ? `, ${x.asOf}` : ""}</span>{x.sourceUrl && <> · <a href={x.sourceUrl} rel="noopener">source</a></>}</span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="small muted">No compliance evidence found in the sources checked — shown as unknown, never as non-compliant.</p>
  )}
  {gaps.length > 0 && <p class="small"><span class="muted">Not yet verified:</span> {gaps.join(", ")} — ask the vendor.</p>}
  <div class="traces">
    <div class="row" style="justify-content: space-between; align-items: baseline">
      <b>Traces</b>
      <span class="tiny muted">{traces.length ? `${traces.length} public · ${inDefence} in defence` : "none public"}</span>
    </div>
    {shown.length > 0 ? (
      <ul class="trace-list">
        {shown.map((t) => (
          <li>
            <span class={`mark ${t.observed?.egress ? "egress" : ""}`} aria-hidden="true">{t.observed?.egress ? "⚠" : "●"}</span>
            <span>
              <a href={traceHref(t)} rel="noopener" style="font-weight: 800">{cap(TRACE_KIND_WORD[t.kind] ?? t.kind)}: {t.title}</a>
              <span class="tiny muted" style="display: block; margin-top: 3px">
                {t.observed?.egress ? "Data left the environment" : t.observed?.refused ? "Refused the instruction" : cap(t.observed.outcome)}
                {t.observed?.approval != null && <> · human approval: {t.observed.approval ? "yes" : "no"}</>}
                {t.vendor_response && <> · vendor response: {t.vendor_response}</>}
                {" "}· T{t.tier} {TRACE_TIER_WORD[t.tier]} · {t.source}, {t.date}
              </span>
            </span>
          </li>
        ))}
      </ul>
    ) : traces.length > 0 ? (
      <p class="tiny muted" style="margin: 6px 0 0">Only the registry's own endpoint probes so far — no published attack or defence trace.</p>
    ) : (
      <p class="tiny muted" style="margin: 6px 0 0">No public trace found. Nobody has published what this agent does under attack.</p>
    )}
  </div>
  {why && <p class="small why"><span class="muted">Why #1:</span> {why}.</p>}
  <p class="small"><a href={`${base}/agents/${r.slug}/`} style="font-weight: 800">Open the full dossier, traces first →</a>{ref && <> · <a href={`${base}/compare/${ref.useCase.id}/`}>worked comparison</a></>}</p>
  <p class="tiny muted">Live specimen, recomputed on every catalog build · identity {IDENTITY_LABEL[r.trust.identity]?.toLowerCase()} · traces from the public record and the registry's own probes, never user-submitted</p>
</aside>

<style>
  .hero-result {
    border: 2px solid var(--ink);
    padding: 18px 20px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper, transparent);
  }
  .hero-result h3 {
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .hero-result h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .hero-result h3 a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .hero-result .score .n {
    font-weight: 800;
    font-size: 1.6rem;
    font-variant-numeric: tabular-nums;
  }
  .hero-result .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hero-result .evidence {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--rule);
    padding-top: 10px;
  }
  .hero-result .evidence li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 8px;
    align-items: baseline;
  }
  .hero-result .mark.found {
    color: var(--accent-ink);
    font-weight: 800;
  }
  .hero-result .why {
    border-top: 1px solid var(--rule);
    padding-top: 10px;
  }
  .hero-result .trace-chip {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }
  .hero-result .traces {
    border-top: 1px solid var(--rule);
    padding-top: 10px;
    font-size: 0.875rem;
  }
  .hero-result .trace-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hero-result .trace-list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 8px;
    align-items: baseline;
  }
  .hero-result .trace-list .mark {
    font-weight: 800;
    color: var(--ink);
  }
  .hero-result .trace-list .mark.egress {
    color: var(--danger);
  }
</style>
