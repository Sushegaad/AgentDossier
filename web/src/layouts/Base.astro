---
import "../styles/global.css";
import { loadIndexMeta } from "../lib/catalog";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "AgentDossier — find AI agents you can actually trust, with the evidence behind every one." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadIndexMeta();
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  ["/domains/", "Domains"],
  ["/search/", "Search"],
  ["/methodology/", "Trust methodology"],
  ["/enterprise/", "Enterprise edition"],
];
const current = (href: string) => path.startsWith(href);
const snapshot = meta?.snapshot_date ?? "the last build";
// Google Analytics 4 with Consent Mode v2. Nothing is stored on the visitor's device until they
// opt in from the banner below; before that GA receives only cookieless, aggregate pings.
// PUBLIC_GA_ID is set for the public demo build only (pages.yml); self-hosted instances leave it unset.
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · AgentDossier</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="ard" type="application/ai-registry+json" href={`${base}/.well-known/ard.json`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap" rel="stylesheet" /></noscript>
    {gaId && (
      <>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          var gtag = window.gtag;
          gtag("consent", "default", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied",
            wait_for_update: 500,
          });
          try {
            if (localStorage.getItem("agentdossier.consent") === "granted") gtag("consent", "update", { analytics_storage: "granted" });
          } catch (e) {}
          gtag("js", new Date());
          gtag("config", gaId, { anonymize_ip: true });
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="disclaimer-bar">
      <div class="container">
        <span class="tag">Reference implementation</span>
        <span>
          Data compiled from public sources as of {snapshot}. Not an assessment, certification or recommendation. Confirm
          current status with the vendor and the issuing body.
        </span>
      </div>
    </div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`}>
          <span class="sq" aria-hidden="true"></span>
          <span>
            <b>AgentDossier <span>· AI Agent Registry</span></b>
            <small>Find agents you can actually trust — public or inside your enterprise.</small>
          </span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={`${base}${href}`} aria-current={current(href) ? "page" : undefined}>
              {label}
            </a>
          ))}
          <a class="btn" href="https://github.com/Sushegaad/AgentDossier">GitHub · MIT</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Reference implementation by Hemant Naik · MIT license · catalog data CC BY 4.0</span>
        <span>ARD = Agentic Resource Discovery · A2A = Agent2Agent · MCP = Model Context Protocol</span>
        <a href={`${base}/changelog/`}>Trust changelog</a>
        <a href={`${base}/methodology/`}>Methodology</a>
        <a href={`${base}/shortlist/`}>Shortlist</a>
        <a href={`${base}/compare/`}>Compare</a>
        <a href={`${base}/private/`}>Private catalog</a>
        <a href="https://github.com/Sushegaad/AgentDossier/blob/main/THIRD_PARTY_NOTICES.md">Third-party notices</a>
        <span>No accounts · {gaId ? "cookieless analytics unless you opt in" : "no analytics"} · no ads</span>
      </div>
    </footer>
    {gaId && (
      <div id="consent" class="consent" hidden role="region" aria-label="Analytics consent">
        <div class="container">
          <span>
            This site uses Google Analytics in cookieless mode: aggregate page counts only, nothing stored on your device.
            Allow analytics cookies to help us understand which pages matter?
          </span>
          <span class="row">
            <button type="button" class="btn small" data-consent="denied">Keep cookieless</button>
            <button type="button" class="btn small primary" data-consent="granted">Allow cookies</button>
          </span>
        </div>
      </div>
      <script is:inline>
        (function () {
          var box = document.getElementById("consent");
          if (!box) return;
          var key = "agentdossier.consent";
          var choice = null;
          try { choice = localStorage.getItem(key); } catch (e) {}
          if (choice) return;
          box.hidden = false;
          box.querySelectorAll("[data-consent]").forEach(function (b) {
            b.addEventListener("click", function () {
              var v = b.getAttribute("data-consent");
              try { localStorage.setItem(key, v); } catch (e) {}
              if (v === "granted" && window.gtag) window.gtag("consent", "update", { analytics_storage: "granted" });
              box.hidden = true;
            });
          });
        })();
      </script>
    )}
    <script>
      // code blocks and wide tables scroll horizontally; make them reachable by keyboard (axe: scrollable-region-focusable)
      for (const el of document.querySelectorAll("pre, .scroll-x")) if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");
    </script>
  </body>
</html>
