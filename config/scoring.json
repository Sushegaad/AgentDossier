    "governance": {"label": "Governance / compliance evidence","seed_max": 100},
    "docs":       {"label": "Docs / transparency",            "seed_max": 10}
  },
  "profiles": {
    "general":       {"adoption": 25, "trust": 20, "health": 15, "ecosystem": 10, "domain_fit": 10, "governance": 5,  "docs": 5},
    "technology":    {"adoption": 30, "trust": 20, "health": 20, "ecosystem": 15, "domain_fit": 10, "governance": 0,  "docs": 5},
    "regulated":     {"adoption": 15, "trust": 25, "health": 10, "ecosystem": 10, "domain_fit": 20, "governance": 15, "docs": 5},
    "security":      {"adoption": 20, "trust": 25, "health": 15, "ecosystem": 10, "domain_fit": 15, "governance": 10, "docs": 5},
    "commercial":    {"adoption": 25, "trust": 20, "health": 15, "ecosystem": 15, "domain_fit": 15, "governance": 5,  "docs": 5},
    "data":          {"adoption": 25, "trust": 20, "health": 20, "ecosystem": 15, "domain_fit": 15, "governance": 0,  "docs": 5},
    "operations":    {"adoption": 20, "trust": 20, "health": 15, "ecosystem": 15, "domain_fit": 20, "governance": 5,  "docs": 5}
