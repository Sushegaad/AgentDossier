{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sushegaad.github.io/AgentDossier/schema/cve_record.schema.json",
  "title": "CveRecord",
  "description": "One official CVE related to an AI agent product, framework, protocol implementation or infrastructure, as the CVE registry (data/cves/index.json) stores it. The description and scores are the official record's own (CVE.org via NVD); category, surface tags, links and status are this registry's classification.",
  "type": "object",
  "required": ["id", "description", "published", "last_modified", "status", "category", "surface", "products", "references", "match", "retrieved_on"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
    "description": { "type": "string", "description": "Verbatim English description from the official record" },
    "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "last_modified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "vuln_status": { "type": ["string", "null"], "description": "NVD vulnStatus, e.g. Analyzed, Awaiting Analysis, Rejected" },
    "cna": { "type": ["string", "null"], "description": "The numbering authority that assigned it (NVD sourceIdentifier)" },
    "cvss": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "score", "severity", "vector", "source"],
      "properties": {
        "version": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "severity": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "vector": { "type": "string" },
        "source": { "type": "string", "description": "Who scored it: nvd@nist.gov or the CNA" }
      }
    },
    "cwe": { "type": "array", "items": { "type": "string", "pattern": "^(CWE-[0-9]+|NVD-CWE-noinfo|NVD-CWE-Other)$" } },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor", "product"],
        "properties": {
          "vendor": { "type": "string" },
          "product": { "type": "string" },
          "versions_affected": { "type": ["string", "null"] },
          "fixed_in": { "type": ["string", "null"] },
          "product_id": { "type": ["string", "null"], "description": "Id in config/cve_products.json when Test A matched" }
        }
      }
    },
    "category": { "type": "string", "enum": ["product", "framework", "protocol", "infrastructure", "unclassified"] },
    "surface": { "type": "array", "items": { "type": "string", "enum": ["prompt_injection", "tool_execution", "code_execution", "exfiltration", "credential_access", "auth_bypass", "supply_chain", "privilege_escalation", "ssrf", "path_traversal", "dos"] } },
    "kev": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["added"],
      "properties": { "added": { "type": "string" }, "due": { "type": ["string", "null"] }, "ransomware": { "type": ["string", "null"] } }
    },
    "fix": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["fixed", "unfixed", "unknown"] },
        "version": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": { "url": { "type": "string" }, "source": { "type": ["string", "null"] }, "tags": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "related_agents": { "type": "array", "items": { "type": "string" } },
    "related_incidents": { "type": "array", "items": { "type": "string", "pattern": "^TR-[0-9]{4}-[0-9]{3}$" } },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "terms"],
      "properties": {
        "tests": { "type": "array", "items": { "type": "string", "enum": ["A:cpe", "A:name", "B:cwe", "B:vocabulary"] } },
        "terms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "type": "string", "enum": ["candidate", "included", "excluded"] },
    "note": { "type": ["string", "null"] },
    "reviewer": { "type": ["string", "null"] },
    "checked_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "retrieved_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "When this registry last read the official record" }
  }
}
