{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sushegaad.github.io/AgentDossier/schema/agents_lock.schema.json",
  "title": "agents.lock.json — the agents a repository depends on, for the AgentDossier policy check",
  "type": "object",
  "required": ["agents"],
  "additionalProperties": false,
  "properties": {
    "registry": { "type": "string", "format": "uri", "description": "Base URL of the AgentDossier instance" },
    "policyId": { "type": "string", "description": "Policy template id on that instance" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Resource id (res_…)" },
          "slug": { "type": "string" },
          "identifier": { "type": "string", "description": "ARD identifier urn:air:<tenant>:catalog:<slug>" },
          "use": { "type": "string", "description": "What this repository uses the agent for" }
        },
        "anyOf": [{ "required": ["id"] }, { "required": ["slug"] }, { "required": ["identifier"] }]
      }
    }
  }
}
