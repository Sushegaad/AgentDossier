# copy to .env and fill in; never commit .env
AGENTDOSSIER_SITE=https://agents.corp.example.com/
AGENTDOSSIER_AUTH_MODE=token
AGENTDOSSIER_API_TOKEN=change-me-reader
AGENTDOSSIER_ADMIN_TOKEN=change-me-admin
# OIDC (set AGENTDOSSIER_AUTH_MODE=oidc)
OIDC_ISSUER=https://login.example.com/realms/corp
OIDC_CLIENT_ID=agentdossier
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=agentdossier-admins
SESSION_SECRET=
# credential the scanner sends to internal agent endpoints (see enterprise.json)
AGENTREG_INTERNAL_TOKEN=
# --- notifications (optional) ------------------------------------------------------
# email: leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentdossier@corp.example.com
SMTP_STARTTLS=1
AGENTDOSSIER_NOTIFY_EMAIL=agent-governance@corp.example.com
# webhook: JSON POST with X-AgentDossier-Event and X-AgentDossier-Signature (HMAC-SHA256 of the body)
AGENTDOSSIER_WEBHOOK_URL=
AGENTDOSSIER_WEBHOOK_SECRET=
# which events leave the instance (default: all): scan.done,scan.failed,catalog.changed,evidence.expiring,test
AGENTDOSSIER_NOTIFY_EVENTS=
# daily evidence-expiry job (UTC cron) and its warning window
AGENTDOSSIER_EXPIRY_CRON=0 7 * * *
AGENTDOSSIER_EXPIRY_WARNING_DAYS=30
