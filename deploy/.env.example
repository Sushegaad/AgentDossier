# copy to .env and fill in; never commit .env
AGENTDOSSIER_SITE=https://agents.corp.example.com/
AGENTDOSSIER_AUTH_MODE=token
AGENTDOSSIER_API_TOKEN=change-me-reader
AGENTDOSSIER_ADMIN_TOKEN=change-me-admin
# OIDC (set AGENTDOSSIER_AUTH_MODE=oidc)
OIDC_ISSUER=https://login.example.com/realms/corp
OIDC_CLIENT_ID=agentdossier
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=agentdossier-admins
# members of this group may sign off decisions and change stages (admins always can)
OIDC_REVIEWER_GROUP=agentdossier-reviewers
SESSION_SECRET=
# credential the scanner sends to internal agent endpoints (see enterprise.json)
AGENTREG_INTERNAL_TOKEN=
# --- notifications (optional) ------------------------------------------------------
# email: leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentdossier@corp.example.com
SMTP_STARTTLS=1
AGENTDOSSIER_NOTIFY_EMAIL=agent-governance@corp.example.com
# webhook: JSON POST with X-AgentDossier-Event and X-AgentDossier-Signature (HMAC-SHA256 of the body)
AGENTDOSSIER_WEBHOOK_URL=
AGENTDOSSIER_WEBHOOK_SECRET=
# which events leave the instance (default: all): scan.done,scan.failed,catalog.changed,evidence.expiring,test
AGENTDOSSIER_NOTIFY_EVENTS=
# --- integrations (optional; each is one more notification channel) ----------------
# chat: every enabled event
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# ticketing: one ticket for scan.failed, evidence.expiring and a decision opened for review
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
SERVICENOW_INSTANCE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident
# GRC system of record: the signed decision packet when a decision is approved, rejected or retired
GRC_WEBHOOK_URL=
GRC_WEBHOOK_SECRET=
# daily evidence-expiry job (UTC cron) and its warning window
AGENTDOSSIER_EXPIRY_CRON=0 7 * * *
AGENTDOSSIER_EXPIRY_WARNING_DAYS=30
# --- federation, SCIM, hardening ------------------------------------------------------
AGENTDOSSIER_FEDERATION_PEERS=
AGENTDOSSIER_FEDERATION_MODE=referrals
AGENTDOSSIER_FEDERATION_TOKEN=
AGENTDOSSIER_FEDERATION_TIMEOUT=5
SCIM_TOKEN=
AGENTDOSSIER_RATE_LIMIT=120/minute
AGENTDOSSIER_MAX_BODY_BYTES=1048576
AGENTDOSSIER_BEHIND_TLS_PROXY=0
